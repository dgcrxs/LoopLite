# ============================================================
# 超算模块加载（module system）
#
# ★ 必须按实际集群修改：先运行 `module avail` 看有哪些版本
# ★ 关键约束：基座官方环境是 CUDA 13.0，但 A100 集群常见 CUDA 11.8 / 12.x。
#    torch 版本必须与【驱动支持的 CUDA 版本】匹配，装高了会报：
#       "CUDA driver version is insufficient for CUDA runtime version"
#    排查命令：nvidia-smi 看右上角 CUDA Version（这是驱动支持的上限）
#
# 若集群不用 module（如容器化环境），把下面内容全部注释掉即可。
# ============================================================

module purge

# ---- CUDA ----
# 候选（按集群实际情况二选一或改版本号）
module load cuda/12.4
# module load cuda/11.8

# ---- 编译器 ----
module load gcc/11.3.0

# ---- 通信库（多机多卡必需）----
# module load openmpi/4.1.5
# module load nccl/2.20

# ---- Python（若集群自带，可不用 venv）----
# module load python/3.11

# ---- 可选：高速存储 ----
# module load lustre

echo "[modules] 已加载: $(module list 2>&1 | tr '\n' ' ')"
